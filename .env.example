# Copy to .env and fill locally. Never commit .env or real keys.

# Optional: enable fork tests (forge test will skip test/fork/* without these)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Required only for Sepolia broadcast + verify (do not invent values)
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Optional: deploy mintable mock WETH on Sepolia instead of canonical WETH
# SEPOLIA_USE_MOCK_WETH=false
